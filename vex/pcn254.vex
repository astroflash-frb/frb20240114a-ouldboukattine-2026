     ref $IF = LO@868MHzDPolNoTone:Wb;
     ref $BBC = 8BBCs:Wb;
     ref $PHASE_CAL_DETECT = NoDetect:Wb;
     ref $FREQ = 1223MHz16x16MHz:Wb;
     ref $TRACKS = VDIF5032.16Ch2bit1to1:Wb;
