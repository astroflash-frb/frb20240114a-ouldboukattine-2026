$MODE;
*
def MIX_BAND1;
     ref $PROCEDURES = Procedure:O8:Wb;
     ref $IF = LO@-53MHzDPolNoTone:Wb;
     ref $IF = LO@708MHzDPolNoTone:O8;
     ref $BBC = 8BBCs:O8;
     ref $BBC = 8BBCs#02:Wb;
     ref $PHASE_CAL_DETECT = NoDetect:O8:Wb;
     ref $FREQ = 1376MHz16x16MHz:O8;
     ref $FREQ = 308MHz16x8MHz:Wb;
     ref $TRACKS = VDIF5032.16Ch2bit1to1:O8:Wb;
     ref $ROLL = NoRoll:O8:Wb;
enddef;
