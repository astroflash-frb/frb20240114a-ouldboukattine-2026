VEX_rev = 1.5;
*    SCHED vers: Development version 11.5. Started Apr. 2
*    VEX/SCHED:  1.5.87
*    Other versions: Sched:  11.5  Plot: 1.06  JPL-ephem: 0.00
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = p49035;
*                                                      +------------+
*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       Non-Repeater CHIME monitoring with Westerbork
*------------------------------------------------------------------------------
$EXPER;
*
def p49035;
     exper_name = p49035;
     exper_description = "No description given.";
     PI_name = "Omar Ould-Boukattine";
     PI_email = o.s.ouldboukattine@uva.nl;
*    address:   ASTRON
*                
*                
*                
*    phone:     0521-595-100
*    during obs: 
*    fax:        
*               PCAL off
*               AGC off, cont_cal OFF
*
*    year, doy: 2025,  22
*    date     : Wed 22 Jan 2025
*    MJD      : 60697
     exper_nominal_start=2025y022d10h00m00s;
     exper_nominal_stop=2025y023d07h20m46s;
*
     target_correlator = JIVE;
*
*    integr_time    :     2.000 s
*    number_channels:    32
*    number_antenna :  6
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : FROM SCHEDULE
*    distribute_to  : 
*                     Onsala Space Observatory
*                     Onsala
*                     Sweden
*    corr_notes : 
*               SFXC correlator with gating
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def MIX_BAND1;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 1376.00MHz16x16MHz:O8;
     ref $IF = LO@708MHzDPolNoTone:O8;
     ref $BBC = 16BBCs:O8;
     ref $TRACKS = VDIF.16Ch2bit1to1:O8;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:O8;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:O8;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def O8;
     ref $SITE = ONSALA85;
     ref $ANTENNA = ONSALA85;
     ref $DAS = 2DBBC+NONE<;
enddef;
*------------------------------------------------------------------------------
$PROCEDURES;
*
def Mode_01;
     procedure_name_prefix =  "01";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;
*------------------------------------------------------------------------------
$SITE;
*
def ONSALA85;
     site_type = fixed;
     site_name = ONSALA85;
     site_ID = O8;
*    elev=   58.47 long=-011:55:04. lat= 57:23:35.1
     site_position = 3370965.87870 m:  711466.19780 m: 5349664.20060 m;
     site_velocity = -0.014360   m/yr:  0.014530   m/yr:  0.010520  m/yr;
*    First line below is VEX standard format.  Use only when readers are ready.
*    site_position_epoch = 2014y001d;
     site_position_epoch =   56658;
enddef;
*------------------------------------------------------------------------------
$ANTENNA;
*
def ONSALA85;
     axis_type = ha : dec;
     antenna_motion = dec :  14.7 deg/min :  5 sec;  *    0.052 deg/sec/sec
     antenna_motion = ha :  17.6 deg/min :  5 sec;  *    0.070 deg/sec/sec
     axis_offset =    2.15000 m;
enddef;
*------------------------------------------------------------------------------
$DAS;
*
def 2DBBC+NONE<;
     record_transport_type = Mark5C;
     electronics_rack_type = DBBC;
     number_drives = 2;
     headstack = 1 :            : 0 ;
     headstack = 2 :            : 1 ;
     tape_motion = adaptive : 0 min: 0 min: 10 sec;
enddef;
*------------------------------------------------------------------------------
$SOURCE;
*
