*------------------------------------------------------------------------------
$FREQ;
*
def 1376.00MHz16x16MHz;
* mode =  1    stations =O8
     sample_rate =    32.000 Ms/sec;  * (2bits/sample)
     chan_def = :  1376.00 MHz : L :  16.00 MHz : &CH01 : &BBC01 : &NoCal; *Rcp
     chan_def = :  1376.00 MHz : L :  16.00 MHz : &CH02 : &BBC09 : &NoCal; *Lcp
     chan_def = :  1376.00 MHz : U :  16.00 MHz : &CH03 : &BBC01 : &NoCal; *Rcp
     chan_def = :  1376.00 MHz : U :  16.00 MHz : &CH04 : &BBC09 : &NoCal; *Lcp
     chan_def = :  1408.00 MHz : L :  16.00 MHz : &CH05 : &BBC02 : &NoCal; *Rcp
     chan_def = :  1408.00 MHz : L :  16.00 MHz : &CH06 : &BBC10 : &NoCal; *Lcp
     chan_def = :  1408.00 MHz : U :  16.00 MHz : &CH07 : &BBC02 : &NoCal; *Rcp
     chan_def = :  1408.00 MHz : U :  16.00 MHz : &CH08 : &BBC10 : &NoCal; *Lcp
     chan_def = :  1440.00 MHz : L :  16.00 MHz : &CH09 : &BBC03 : &NoCal; *Rcp
     chan_def = :  1440.00 MHz : L :  16.00 MHz : &CH10 : &BBC11 : &NoCal; *Lcp
     chan_def = :  1440.00 MHz : U :  16.00 MHz : &CH11 : &BBC03 : &NoCal; *Rcp
     chan_def = :  1440.00 MHz : U :  16.00 MHz : &CH12 : &BBC11 : &NoCal; *Lcp
     chan_def = :  1472.00 MHz : L :  16.00 MHz : &CH13 : &BBC04 : &NoCal; *Rcp
     chan_def = :  1472.00 MHz : L :  16.00 MHz : &CH14 : &BBC12 : &NoCal; *Lcp
     chan_def = :  1472.00 MHz : U :  16.00 MHz : &CH15 : &BBC04 : &NoCal; *Rcp
     chan_def = :  1472.00 MHz : U :  16.00 MHz : &CH16 : &BBC12 : &NoCal; *Lcp
enddef;
*------------------------------------------------------------------------------
$IF;
*
def LO@708MHzDPolNoTone;
* mode =  1    stations =O8
     if_def = &IF_A1 : A1 : R :   708.00 MHz : U ; * PCall off!   0.0   0.0  NA     0 NA
     if_def = &IF_C1 : C1 : L :   708.00 MHz : U ; * PCall off!   0.0   0.0  NA     0 NA
enddef;
*------------------------------------------------------------------------------
$BBC;
*
def 16BBCs;
* mode =  1    stations =O8
     BBC_assign = &BBC01 :  1 : &IF_A1;
     BBC_assign = &BBC09 :  9 : &IF_C1;
     BBC_assign = &BBC02 :  2 : &IF_A1;
     BBC_assign = &BBC10 : 10 : &IF_C1;
     BBC_assign = &BBC03 :  3 : &IF_A1;
     BBC_assign = &BBC11 : 11 : &IF_C1;
     BBC_assign = &BBC04 :  4 : &IF_A1;
     BBC_assign = &BBC12 : 12 : &IF_C1;
enddef;
*------------------------------------------------------------------------------
$PHASE_CAL_DETECT;
*
def NoDetect;
* mode =  1    stations =O8
     phase_cal_detect = &NoCal;
enddef;
*------------------------------------------------------------------------------
$TRACKS;
*
def VDIF.16Ch2bit1to1;
* mode =  1    stations =O8
*    firmware_type = DBBC_DDC;
*    format = VDIF, and fan-out = 1
*    mode requires  32.00Mb/s/tr; stations using disks
     track_frame_format = VDIF5032;
     fanout_def =   : &CH01 : sign : 1:  1;
     fanout_def =   : &CH01 :  mag : 1:  1;
     fanout_def =   : &CH02 : sign : 1:  2;
     fanout_def =   : &CH02 :  mag : 1:  2;
     fanout_def =   : &CH03 : sign : 1:  3;
     fanout_def =   : &CH03 :  mag : 1:  3;
     fanout_def =   : &CH04 : sign : 1:  4;
     fanout_def =   : &CH04 :  mag : 1:  4;
     fanout_def =   : &CH05 : sign : 1:  5;
     fanout_def =   : &CH05 :  mag : 1:  5;
     fanout_def =   : &CH06 : sign : 1:  6;
     fanout_def =   : &CH06 :  mag : 1:  6;
     fanout_def =   : &CH07 : sign : 1:  7;
     fanout_def =   : &CH07 :  mag : 1:  7;
     fanout_def =   : &CH08 : sign : 1:  8;
     fanout_def =   : &CH08 :  mag : 1:  8;
     fanout_def =   : &CH09 : sign : 1:  9;
     fanout_def =   : &CH09 :  mag : 1:  9;
     fanout_def =   : &CH10 : sign : 1: 10;
     fanout_def =   : &CH10 :  mag : 1: 10;
     fanout_def =   : &CH11 : sign : 1: 11;
     fanout_def =   : &CH11 :  mag : 1: 11;
     fanout_def =   : &CH12 : sign : 1: 12;
     fanout_def =   : &CH12 :  mag : 1: 12;
     fanout_def =   : &CH13 : sign : 1: 13;
     fanout_def =   : &CH13 :  mag : 1: 13;
     fanout_def =   : &CH14 : sign : 1: 14;
     fanout_def =   : &CH14 :  mag : 1: 14;
     fanout_def =   : &CH15 : sign : 1: 15;
     fanout_def =   : &CH15 :  mag : 1: 15;
     fanout_def =   : &CH16 : sign : 1: 16;
     fanout_def =   : &CH16 :  mag : 1: 16;
enddef;
