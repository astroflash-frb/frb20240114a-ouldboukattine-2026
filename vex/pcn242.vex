VEX_rev = 1.5;
*    pySCHED version: 1.25.0
*    SCHED version:   Release 11.6; Feburary 2020
*    VEX/SCHED:       1.5.4
*    Other versions: Sched:  11.6 JPL-ephem: 1.01
*    Catalog versions:
*       Frequency: 2022Oct12-14:18:19
*       Station:   2018Sep07-20:14:11
*       Location:  2016Dec19-16:00:00
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = pcn242;
*                                                      +------------+
*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       Non-Repeater CHIME monitoring with Westerbork
*------------------------------------------------------------------------------
$EXPER;
*
def pcn242;
     exper_name = pcn242;
     exper_description = "";
     PI_name = "Omar Ould-Boukattine";
     PI_email = o.s.ouldboukattine@uva.nl;
*    address:   ASTRON
*               
*               
*               
*    phone:     0521-595-100
*    during obs:
*    fax:       
*    PCAL off
*    AGC off, cont_cal OFF
*
*    year, doy: 2024, 32
*    date     : Thu 1 Feb 2024
*    MJD      : 60341
     exper_nominal_start=2024y032d07h21m00s;
     exper_nominal_stop=2024y033d06h59m25s;
*
     target_correlator = JIVE;
*
*    integr_time    : 2.0 s
*    number_channels: 32
*    number_antenna : 6
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : FROM SCHEDULE
*    distribute_to  :
*                     Onsala Space Observatory
*                     Onsala
*                     Sweden
*                     
*    SFXC correlator with gating
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def wb_pband;
     ref $PROCEDURES = Procedure:Wb;
     ref $IF = LO@-53MHzDPolNoTone:Wb;
     ref $BBC = 8BBCs:Wb;
     ref $PHASE_CAL_DETECT = NoDetect:Wb;
     ref $FREQ = 308MHz16x8MHz:Wb;
     ref $TRACKS = VDIF5032.16Ch2bit1to1:Wb;
     ref $ROLL = NoRoll:Wb;
enddef;
*------------------------------------------------------------------------------
$IF;
*
def LO@-53MHzDPolNoTone;
* wb_pband: Wb
     if_def = &IF_A1 : A1 : R :    -53.00 MHz : U;
     if_def = &IF_B1 : B1 : L :    -53.00 MHz : U;
enddef;
*------------------------------------------------------------------------------
$BBC;
*
def 8BBCs;
* wb_pband: Wb
     BBC_assign = &BBC01 :  1 : &IF_A1;
     BBC_assign = &BBC09 :  9 : &IF_B1;
     BBC_assign = &BBC02 :  2 : &IF_A1;
     BBC_assign = &BBC10 : 10 : &IF_B1;
     BBC_assign = &BBC03 :  3 : &IF_A1;
     BBC_assign = &BBC11 : 11 : &IF_B1;
     BBC_assign = &BBC04 :  4 : &IF_A1;
     BBC_assign = &BBC12 : 12 : &IF_B1;
enddef;
*------------------------------------------------------------------------------
$PHASE_CAL_DETECT;
*
def NoDetect;
* wb_pband: Wb
     phase_cal_detect = &NoCal;
enddef;
*------------------------------------------------------------------------------
$FREQ;
*
def 308MHz16x8MHz;
* wb_pband: Wb
     chan_def =  : 308 MHz : L :    8.00 MHz : &CH01 : &BBC01 : &NoCal; * RCP
     chan_def =  : 308 MHz : L :    8.00 MHz : &CH02 : &BBC09 : &NoCal; * LCP
     chan_def =  : 308 MHz : U :    8.00 MHz : &CH03 : &BBC01 : &NoCal; * RCP
     chan_def =  : 308 MHz : U :    8.00 MHz : &CH04 : &BBC09 : &NoCal; * LCP
     chan_def =  : 324 MHz : L :    8.00 MHz : &CH05 : &BBC02 : &NoCal; * RCP
     chan_def =  : 324 MHz : L :    8.00 MHz : &CH06 : &BBC10 : &NoCal; * LCP
     chan_def =  : 324 MHz : U :    8.00 MHz : &CH07 : &BBC02 : &NoCal; * RCP
     chan_def =  : 324 MHz : U :    8.00 MHz : &CH08 : &BBC10 : &NoCal; * LCP
     chan_def =  : 340 MHz : L :    8.00 MHz : &CH09 : &BBC03 : &NoCal; * RCP
     chan_def =  : 340 MHz : L :    8.00 MHz : &CH10 : &BBC11 : &NoCal; * LCP
     chan_def =  : 340 MHz : U :    8.00 MHz : &CH11 : &BBC03 : &NoCal; * RCP
     chan_def =  : 340 MHz : U :    8.00 MHz : &CH12 : &BBC11 : &NoCal; * LCP
     chan_def =  : 356 MHz : L :    8.00 MHz : &CH13 : &BBC04 : &NoCal; * RCP
     chan_def =  : 356 MHz : L :    8.00 MHz : &CH14 : &BBC12 : &NoCal; * LCP
     chan_def =  : 356 MHz : U :    8.00 MHz : &CH15 : &BBC04 : &NoCal; * RCP
     chan_def =  : 356 MHz : U :    8.00 MHz : &CH16 : &BBC12 : &NoCal; * LCP
     sample_rate =  16.000 Ms/sec;
enddef;
*------------------------------------------------------------------------------
$TRACKS;
*
def VDIF5032.16Ch2bit1to1;
* wb_pband: Wb
     track_frame_format = VDIF5032;
     fanout_def =  : &CH01 : sign : 1 :  1;
     fanout_def =  : &CH01 :  mag : 1 :  1;
     fanout_def =  : &CH02 : sign : 1 :  2;
     fanout_def =  : &CH02 :  mag : 1 :  2;
     fanout_def =  : &CH03 : sign : 1 :  3;
     fanout_def =  : &CH03 :  mag : 1 :  3;
