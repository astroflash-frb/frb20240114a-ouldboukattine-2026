VEX_rev = 1.5;
*    SCHED vers: Release 11.7; June 2022
*    VEX/SCHED:  1.5.88
*    Other versions: Sched:  11.7  Plot: 1.06  JPL-ephem: 1.01
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = rn1l13;
*                                                      +------------+
*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       M82 searching - L-band (21cm) at 1 Gbit/s - group A
*------------------------------------------------------------------------------
$EXPER;
*
def rn1l13;
     exper_name = rn1l13;
     exper_description = "No description given.";
     PI_name = WP;
     PI_email = motylek@astro.umk.pl;
*    address:   IAUMK
*                
*                
*                
*    phone:     +48 605463363
*    during obs:+48 00000000
*    fax:       +48 00000000
*               PCAL off
*               AGC off, cont_cal OFF
*
*    year, doy: 2024,  89
*    date     : Fri 29 Mar 2024
*    MJD      : 60398
     exper_nominal_start=2024y089d06h30m00s;
     exper_nominal_stop=2024y089d11h46m05s;
*
     target_correlator = JIVE;
*
*    integr_time    :     2.000 s
*    number_channels:     3
*    number_antenna :  6
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : FROM CHEDULE
*    distribute_to  : 
*                     IAUMK
*                     IAUMK
*                     IAUMK
*    corr_notes : 
*               SFXC correlator with gating
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def TR_L_256;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 1322.00MHz16x32MHz:Tr;
     ref $IF = LO@2130MHzDPolNoTone:Tr;
     ref $BBC = 16BBCs:Tr;
     ref $TRACKS = VDIF.16Ch2bit1to1:Tr;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Tr;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:Tr;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def Tr;
     ref $SITE = TORUN;
     ref $ANTENNA = TORUN;
     ref $DAS = 2DBBC+NONE<;
enddef;
*------------------------------------------------------------------------------
$PROCEDURES;
*
def Mode_01;
     procedure_name_prefix =  "01";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;
*------------------------------------------------------------------------------
$SITE;
*
def TORUN;
     site_type = fixed;
     site_name = TORUN;
     site_ID = Tr;
*    elev=  133.61 long=-018:33:50. lat= 53:05:43.7
     site_position = 3638558.51000 m: 1221969.72000 m: 5077036.76000 m;
     site_velocity = -0.016010   m/yr:  0.016450   m/yr:  0.007520  m/yr;
*    First line below is VEX standard format.  Use only when readers are ready.
*    site_position_epoch = 1997y001d;
     site_position_epoch =   50449;
     horizon_map_az =  0.0 deg:360.0;
     horizon_map_el =  2.0 deg:  2.0;
enddef;
*------------------------------------------------------------------------------
$ANTENNA;
*
def TORUN;
     axis_type = az : el;
     antenna_motion = el :  16.0 deg/min :  5 sec;  *    0.030 deg/sec/sec
     antenna_motion = az :  30.0 deg/min :  5 sec;  *    0.050 deg/sec/sec
     axis_offset =    0.00000 m;
enddef;
*------------------------------------------------------------------------------
$DAS;
*
def 2DBBC+NONE<;
     record_transport_type = Mark5C;
     electronics_rack_type = DBBC;
     number_drives = 2;
     headstack = 1 :            : 0 ;
     headstack = 2 :            : 1 ;
     tape_motion = adaptive : 0 min: 0 min: 10 sec;
enddef;
*------------------------------------------------------------------------------
$SOURCE;
*
def R240121;
     source_name = R240121;
*    this source had calibrator code:  
     ra = 21h27m39.8880000s; dec =  04d21'00.360000"; ref_coord_frame = J2000;
*    ra = 21h25m09.1824044s; dec =  04d07'54.959111"; ref_coord_frame = B1950;
*    ra = 21h28m51.6710175s; dec =  04d27'07.064858"; ref_coord_frame = Date;
*    velocity_wrt_LSR =       0.00 km/sec; * warning, only given here for 1st channel
*    calculations used radio definition 
enddef;
*
def B1929+10;
     source_name = B1929+10;
*    this source had calibrator code:  
     ra = 19h32m14.0000000s; dec =  10d59'33.400000"; ref_coord_frame = J2000;
*    ra = 19h29m52.1185395s; dec =  10d53'05.643161"; ref_coord_frame = B1950;
*    ra = 19h33m22.0741323s; dec =  11d02'24.016314"; ref_coord_frame = Date;
*    velocity_wrt_LSR =       0.00 km/sec; * warning, only given here for 1st channel
