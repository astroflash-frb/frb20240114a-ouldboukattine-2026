def p47025;
     exper_name = p47025;
     exper_description = "No description given.";
     PI_name = "Omar Ould-Boukattine";
     PI_email = o.s.ouldboukattine@uva.nl;
*    address:   ASTRON
*                
*                
*                
*    phone:     0521-595-100
*    during obs: 
*    fax:        
*               PCAL off
*               AGC off, cont_cal OFF
*
*    year, doy: 2024,  72
*    date     : Tue 12 Mar 2024
*    MJD      : 60381
     exper_nominal_start=2024y072d04h15m00s;
     exper_nominal_stop=2024y072d15h05m03s;
*
     target_correlator = JIVE;
*
*    integr_time    :     2.000 s
*    number_channels:    32
*    number_antenna :  6
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
