$IF;
*
def LO@868MHzDPolNoTone;
* wb_lband_1215_16: Wb
     if_def = &IF_A1 : A1 : R :    868.00 MHz : U;
     if_def = &IF_B1 : B1 : L :    868.00 MHz : U;
enddef;
*------------------------------------------------------------------------------
$BBC;
*
def 8BBCs;
* wb_lband_1215_16: Wb
