*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       R240121 monitoring - L-band (21cm) at 1 Gbit/s - group A
*------------------------------------------------------------------------------
$EXPER;
*
def rn1l70;
     exper_name = rn1l70;
     exper_description = "No description given.";
     PI_name = WP;
     PI_email = motylek@astro.umk.pl;
*    address:   IAUMK
*                
*                
*                
*    phone:     +48 605463363
*    during obs:+48 00000000
*    fax:       +48 00000000
*               PCAL off
*               AGC off, cont_cal OFF
*
*    year, doy: 2025,  23
*    date     : Thu 23 Jan 2025
*    MJD      : 60698
     exper_nominal_start=2025y023d11h45m00s;
     exper_nominal_stop=2025y023d16h35m00s;
*
     target_correlator = JIVE;
*
*    integr_time    :     2.000 s
*    number_channels:     3
*    number_antenna :  6
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : FROM CHEDULE
*    distribute_to  : 
*                     IAUMK
*                     IAUMK
*                     IAUMK
*    corr_notes : 
*               SFXC correlator with gating
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def TR_LA;
    ref $THREADS = THREADS.TR_LA.Tr:Tr;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 1396.00MHz16x16MHz:Tr;
     ref $IF = LO@2130MHzDPolNoTone:Tr;
     ref $BBC = 16BBCs:Tr;
     ref $TRACKS = VDIF.16Ch2bit1to1:Tr;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Tr;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:Tr;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def Tr;
    ref $TAPELOG_OBS = Tr;
    ref $CLOCK = Tr;
     ref $SITE = TORUN;
     ref $ANTENNA = TORUN;
     ref $DAS = 2DBBC+NONE<;
enddef;
*------------------------------------------------------------------------------
$ANTENNA;
*
def TORUN;
     axis_type = az : el;
     antenna_motion = el :  16.0 deg/min :  5 sec;  *    0.030 deg/sec/sec
     antenna_motion = az :  30.0 deg/min :  5 sec;  *    0.050 deg/sec/sec
     axis_offset =    0.00000 m;
enddef;
*------------------------------------------------------------------------------
$SITE;
*
def TORUN;
     site_type = fixed;
     site_name = TORUN;
     site_ID = Tr;
*    elev=  133.61 long=-018:33:50. lat= 53:05:43.7
     site_position = 3638558.51000 m: 1221969.72000 m: 5077036.76000 m;
     site_velocity = -0.016010   m/yr:  0.016450   m/yr:  0.007520  m/yr;
*    First line below is VEX standard format.  Use only when readers are ready.
*    site_position_epoch = 1997y001d;
     site_position_epoch =   50449;
     horizon_map_az =  0.0 deg:360.0;
     horizon_map_el =  2.0 deg:  2.0;
enddef;
*------------------------------------------------------------------------------
$IF;
*
def LO@2130MHzDPolNoTone;
* mode =  1    stations =Tr
     if_def = &IF_A1 : A1 : R :  2130.00 MHz : L ; * PCall off!   0.0   0.0  NA     0 NA
     if_def = &IF_B1 : B1 : L :  2130.00 MHz : L ; * PCall off!   0.0   0.0  NA     0 NA
enddef;
*------------------------------------------------------------------------------
$BBC;
*
def 16BBCs;
* mode =  1    stations =Tr
     BBC_assign = &BBC01 :  1 : &IF_A1;
     BBC_assign = &BBC09 :  9 : &IF_B1;
     BBC_assign = &BBC02 :  2 : &IF_A1;
     BBC_assign = &BBC10 : 10 : &IF_B1;
     BBC_assign = &BBC03 :  3 : &IF_A1;
     BBC_assign = &BBC11 : 11 : &IF_B1;
     BBC_assign = &BBC04 :  4 : &IF_A1;
     BBC_assign = &BBC12 : 12 : &IF_B1;
enddef;
*------------------------------------------------------------------------------
$FREQ;
*
def 1396.00MHz16x16MHz;
* mode =  1    stations =Tr
     sample_rate =    32.000 Ms/sec;  * (2bits/sample)
     chan_def = :  1396.00 MHz : L :  16.00 MHz : &CH01 : &BBC01 : &NoCal; *Rcp
     chan_def = :  1396.00 MHz : L :  16.00 MHz : &CH02 : &BBC09 : &NoCal; *Lcp
     chan_def = :  1396.00 MHz : U :  16.00 MHz : &CH03 : &BBC01 : &NoCal; *Rcp
     chan_def = :  1396.00 MHz : U :  16.00 MHz : &CH04 : &BBC09 : &NoCal; *Lcp
     chan_def = :  1428.00 MHz : L :  16.00 MHz : &CH05 : &BBC02 : &NoCal; *Rcp
     chan_def = :  1428.00 MHz : L :  16.00 MHz : &CH06 : &BBC10 : &NoCal; *Lcp
     chan_def = :  1428.00 MHz : U :  16.00 MHz : &CH07 : &BBC02 : &NoCal; *Rcp
     chan_def = :  1428.00 MHz : U :  16.00 MHz : &CH08 : &BBC10 : &NoCal; *Lcp
     chan_def = :  1460.00 MHz : L :  16.00 MHz : &CH09 : &BBC03 : &NoCal; *Rcp
     chan_def = :  1460.00 MHz : L :  16.00 MHz : &CH10 : &BBC11 : &NoCal; *Lcp
     chan_def = :  1460.00 MHz : U :  16.00 MHz : &CH11 : &BBC03 : &NoCal; *Rcp
     chan_def = :  1460.00 MHz : U :  16.00 MHz : &CH12 : &BBC11 : &NoCal; *Lcp
     chan_def = :  1492.00 MHz : L :  16.00 MHz : &CH13 : &BBC04 : &NoCal; *Rcp
     chan_def = :  1492.00 MHz : L :  16.00 MHz : &CH14 : &BBC12 : &NoCal; *Lcp
     chan_def = :  1492.00 MHz : U :  16.00 MHz : &CH15 : &BBC04 : &NoCal; *Rcp
     chan_def = :  1492.00 MHz : U :  16.00 MHz : &CH16 : &BBC12 : &NoCal; *Lcp
enddef;
*------------------------------------------------------------------------------
$TRACKS;
*
def VDIF.16Ch2bit1to1;
* mode =  1    stations =Tr
*    firmware_type = DBBC_DDC;
*    format = VDIF, and fan-out = 1
*    mode requires  32.00Mb/s/tr; stations using disks
     track_frame_format = VDIF5032;
     fanout_def =   : &CH01 : sign : 1:  1;
     fanout_def =   : &CH01 :  mag : 1:  1;
     fanout_def =   : &CH02 : sign : 1:  2;
     fanout_def =   : &CH02 :  mag : 1:  2;
     fanout_def =   : &CH03 : sign : 1:  3;
     fanout_def =   : &CH03 :  mag : 1:  3;
     fanout_def =   : &CH04 : sign : 1:  4;
     fanout_def =   : &CH04 :  mag : 1:  4;
     fanout_def =   : &CH05 : sign : 1:  5;
     fanout_def =   : &CH05 :  mag : 1:  5;
     fanout_def =   : &CH06 : sign : 1:  6;
     fanout_def =   : &CH06 :  mag : 1:  6;
     fanout_def =   : &CH07 : sign : 1:  7;
     fanout_def =   : &CH07 :  mag : 1:  7;
     fanout_def =   : &CH08 : sign : 1:  8;
     fanout_def =   : &CH08 :  mag : 1:  8;
     fanout_def =   : &CH09 : sign : 1:  9;
     fanout_def =   : &CH09 :  mag : 1:  9;
     fanout_def =   : &CH10 : sign : 1: 10;
     fanout_def =   : &CH10 :  mag : 1: 10;
     fanout_def =   : &CH11 : sign : 1: 11;
     fanout_def =   : &CH11 :  mag : 1: 11;
     fanout_def =   : &CH12 : sign : 1: 12;
     fanout_def =   : &CH12 :  mag : 1: 12;
     fanout_def =   : &CH13 : sign : 1: 13;
     fanout_def =   : &CH13 :  mag : 1: 13;
     fanout_def =   : &CH14 : sign : 1: 14;
     fanout_def =   : &CH14 :  mag : 1: 14;
     fanout_def =   : &CH15 : sign : 1: 15;
     fanout_def =   : &CH15 :  mag : 1: 15;
     fanout_def =   : &CH16 : sign : 1: 16;
     fanout_def =   : &CH16 :  mag : 1: 16;
enddef;
